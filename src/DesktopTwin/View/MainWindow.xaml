<ui:FluentWindow x:Class="DesktopTwin.View.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:behaviors="clr-namespace:DesktopTwin.View.Behaviors"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:DesktopTwin.Localization"
                 xmlns:viewModel="clr-namespace:DesktopTwin.ViewModel"
                 xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
                 Title="{loc:Loc Main.Title}"
                 Icon="pack://application:,,,/Assets/DesktopTwin.ico"
                 Width="1280"
                 Height="752"
                 MinWidth="415"
                 MinHeight="120"
                 d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel}"
                 Background="#FF1F1F1F"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="CanResize"
                 Topmost="{Binding IsTopmost, Mode=OneWay}"
                 WindowBackdropType="None"
                 WindowStartupLocation="CenterScreen"
                 mc:Ignorable="d">
    <Grid x:Name="RootGrid"
          Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 标题栏：左侧状态灯，右侧全部控制入口 ===== -->
        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Height="32"
                     Background="#FF1F1F1F"
                     VerticalContentAlignment="Top">
            <ui:TitleBar.Header>
                <!-- 左侧留出与窗口边框的距离：ExtendsContentIntoTitleBar 下标题栏内容从 x=0 开始，
                     不留边距时状态灯会贴着窗口左边缘。12 与系统标题栏图标的缩进量一致。 -->
                <StackPanel Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <b:Interaction.Behaviors>
                        <behaviors:WindowDragBehavior />
                    </b:Interaction.Behaviors>
                    <Ellipse Width="9"
                             Height="9"
                             Margin="0,0,8,0"
                             Fill="{Binding ConnectionStatusBrush}"
                             ToolTip="{Binding ConnectionStatusToolTip}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{loc:Loc Main.Title}" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel VerticalAlignment="Top"
                            IsEnabled="{Binding IsSessionInteractionEnabled}"
                            Orientation="Horizontal">
                    <b:Interaction.Behaviors>
                        <behaviors:ResponsiveTitleBarBehavior />
                    </b:Interaction.Behaviors>

                    <ui:Button x:Name="StartButton"
                               Width="80"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               behaviors:ResponsiveTitleBarBehavior.CollapseOrder="1"
                               Command="{Binding StartCommand}"
                               Content="{loc:Loc Main.Start}"
                               CornerRadius="0"
                               Icon="{ui:SymbolIcon Play24}"
                               ToolTip="{loc:Loc Main.Start.ToolTip}" />
                    <ui:Button x:Name="HideButton"
                               Width="80"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               behaviors:ResponsiveTitleBarBehavior.CollapseOrder="2"
                               Command="{Binding HideCommand}"
                               Content="{loc:Loc Main.Hide}"
                               CornerRadius="0"
                               Icon="{ui:SymbolIcon EyeOff24}"
                               ToolTip="{loc:Loc Main.Hide.ToolTip}" />
                    <ui:Button x:Name="SwitchWindowButton"
                               Width="110"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               behaviors:ResponsiveTitleBarBehavior.CollapseOrder="3"
                               Command="{Binding SwitchWindowCommand}"
                               Content="{loc:Loc Main.SwitchWindow}"
                               CornerRadius="0"
                               Icon="{ui:SymbolIcon ArrowSwap24}"
                               ToolTip="{loc:Loc Main.SwitchWindow.ToolTip}" />

                    <!-- 窗口变窄时，被折叠的按钮在这里仍然可用 -->
                    <ui:DropDownButton Width="40"
                                       Height="32"
                                       Background="Transparent"
                                       BorderBrush="Transparent"
                                       CornerRadius="0"
                                       Visibility="{Binding ElementName=StartButton, Path=IsVisible, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                        <ui:DropDownButton.Icon>
                            <ui:SymbolIcon FontSize="16" Symbol="MoreHorizontal24" />
                        </ui:DropDownButton.Icon>
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <ui:MenuItem Command="{Binding StartCommand}"
                                             Header="{loc:Loc Menu.Start}"
                                             Icon="{ui:SymbolIcon Play24}"
                                             Visibility="{Binding Source={x:Reference StartButton}, Path=IsVisible, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                                <ui:MenuItem Command="{Binding HideCommand}"
                                             Header="{loc:Loc Menu.Hide}"
                                             Icon="{ui:SymbolIcon EyeOff24}"
                                             Visibility="{Binding Source={x:Reference HideButton}, Path=IsVisible, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                                <ui:MenuItem Command="{Binding SwitchWindowCommand}"
                                             Header="{loc:Loc Menu.SwitchWindow}"
                                             Icon="{ui:SymbolIcon ArrowSwap24}"
                                             Visibility="{Binding Source={x:Reference SwitchWindowButton}, Path=IsVisible, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <ui:DropDownButton Width="120"
                                       Height="32"
                                       Background="Transparent"
                                       BorderBrush="Transparent"
                                       Content="{loc:Loc Main.ControlCenter}"
                                       CornerRadius="0"
                                       Icon="{ui:SymbolIcon AppsList24}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <ui:MenuItem Command="{Binding SelectTargetProgramCommand}"
                                             Header="{loc:Loc Menu.SelectTarget}"
                                             Icon="{ui:SymbolIcon FolderOpen24}" />
                                <ui:MenuItem Command="{Binding LaunchTargetCommand}"
                                             Header="{loc:Loc Menu.LaunchTarget}"
                                             Icon="{ui:SymbolIcon Play24}" />
                                <ui:MenuItem Header="{Binding TargetProgramText, StringFormat={loc:Loc Menu.TargetProgram}}"
                                             IsEnabled="False" />
                                <ui:MenuItem Command="{Binding ToggleAutoLaunchCommand}"
                                             Header="{loc:Loc Menu.AutoLaunch}"
                                             IsCheckable="True"
                                             IsChecked="{Binding AutoLaunchOnConnect, Mode=OneWay}" />
                                <ui:MenuItem Command="{Binding ToggleRunAsAdministratorCommand}"
                                             Header="{loc:Loc Menu.RunAsAdmin}"
                                             IsCheckable="True"
                                             IsChecked="{Binding RunAsAdministrator, Mode=OneWay}"
                                             ToolTip="{loc:Loc Menu.RunAsAdmin.ToolTip}" />
                                <Separator />
                                <ui:MenuItem Command="{Binding ToggleSmallWindowModeCommand}"
                                             Header="{Binding WindowSizeModeMenuHeader}"
                                             ToolTip="{Binding WindowSizeModeMenuToolTip}" />
                                <ui:MenuItem Command="{Binding ToggleWatchModeCommand}"
                                             Header="{Binding WatchModeMenuHeader}"
                                             ToolTip="{Binding WatchModeMenuToolTip}" />
                                <Separator />
                                <ui:MenuItem Header="{loc:Loc Menu.Resolution}">
                                    <ui:MenuItem Command="{Binding SelectResolutionCommand}"
                                                 CommandParameter="1920x1080"
                                                 Header="1920 × 1080"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding IsDefaultResolutionSelected, Mode=OneWay}" />
                                    <ui:MenuItem Command="{Binding SelectResolutionCommand}"
                                                 CommandParameter="2560x1440"
                                                 Header="2560 × 1440"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding IsQuadHdResolutionSelected, Mode=OneWay}" />
                                    <ui:MenuItem Command="{Binding SelectResolutionCommand}"
                                                 CommandParameter="1600x900"
                                                 Header="1600 × 900"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding IsHdPlusResolutionSelected, Mode=OneWay}" />
                                    <ui:MenuItem Command="{Binding SelectResolutionCommand}"
                                                 CommandParameter="1280x720"
                                                 Header="1280 × 720"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding IsHdResolutionSelected, Mode=OneWay}" />
                                    <Separator />
                                    <ui:MenuItem Command="{Binding CustomResolutionCommand}"
                                                 Header="{loc:Loc Menu.Resolution.Custom}"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding IsCustomResolutionSelected, Mode=OneWay}"
                                                 ToolTip="{loc:Loc Menu.Resolution.Custom.ToolTip}" />
                                </ui:MenuItem>
                                <ui:MenuItem Header="{loc:Loc Menu.Window}">
                                    <ui:MenuItem Command="{Binding UseAdaptiveCommand}"
                                                 Header="{loc:Loc Menu.Adaptive}"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding IsAdaptive, Mode=OneWay}" />
                                    <ui:MenuItem Command="{Binding UseOneToOneCommand}"
                                                 Header="1 : 1"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding IsOneToOne, Mode=OneWay}" />
                                    <Separator />
                                    <ui:MenuItem Command="{Binding ToggleKeepAspectRatioCommand}"
                                                 Header="{loc:Loc Menu.KeepAspectRatio}"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding KeepAspectRatio, Mode=OneWay}" />
                                </ui:MenuItem>
                                <ui:MenuItem Header="{loc:Loc Menu.Shortcuts}">
                                    <ui:MenuItem Command="{Binding ToggleSendSystemShortcutsToRemoteCommand}"
                                                 Header="{loc:Loc Menu.SendSystemShortcuts}"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding SendSystemShortcutsToRemote, Mode=OneWay}"
                                                 ToolTip="{loc:Loc Menu.SendSystemShortcuts.ToolTip}" />
                                    <Separator />
                                    <ui:MenuItem Command="{Binding ShowDesktopCommand}"
                                                 Header="{loc:Loc Menu.SendWinD}" />
                                    <ui:MenuItem Command="{Binding ShowTaskViewCommand}"
                                                 Header="{loc:Loc Menu.SendWinTab}" />
                                    <Separator />
                                    <ui:MenuItem Command="{Binding ToggleUuViewSwitchCommand}"
                                                 Header="{Binding UuViewSwitchMenuHeader}"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding UuViewSwitchEnabled, Mode=OneWay}"
                                                 ToolTip="{loc:Loc Menu.UuSwitch.ToolTip}" />
                                    <ui:MenuItem Command="{Binding ConfigureUuHotkeyCommand}"
                                                 Header="{Binding UuHotkeyText, StringFormat={loc:Loc Menu.UuHotkey}}" />
                                    <ui:MenuItem Command="{Binding TriggerUuViewSwitchCommand}"
                                                 Header="{loc:Loc Menu.UuTrigger}" />
                                    <ui:MenuItem Command="{Binding RepairUuStreamingCommand}"
                                                 Header="{loc:Loc Menu.UuRepair}"
                                                 ToolTip="{loc:Loc Menu.UuRepair.ToolTip}" />
                                </ui:MenuItem>
                                <ui:MenuItem Header="{Binding AutoLoginMenuHeader}">
                                    <ui:MenuItem Command="{Binding ShowAutoLoginOptionsCommand}"
                                                 Header="{loc:Loc Menu.AutoLogin.Settings}"
                                                 Icon="{ui:SymbolIcon Settings24}"
                                                 ToolTip="{loc:Loc Menu.AutoLogin.Settings.ToolTip}" />
                                    <Separator />
                                    <ui:MenuItem Command="{Binding ToggleAutoLoginCommand}"
                                                 Header="{loc:Loc Menu.AutoLogin.Enable}"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding AutoLoginEnabled, Mode=OneWay}"
                                                 ToolTip="{loc:Loc Menu.AutoLogin.Enable.ToolTip}" />
                                    <ui:MenuItem Command="{Binding SetAutoLoginPasswordCommand}"
                                                 Header="{loc:Loc Menu.AutoLogin.SetPassword}" />
                                    <ui:MenuItem Command="{Binding ClearAutoLoginPasswordCommand}"
                                                 Header="{loc:Loc Menu.AutoLogin.ClearPassword}"
                                                 IsEnabled="{Binding HasAutoLoginPassword}" />
                                    <Separator />
                                    <ui:MenuItem Command="{Binding OpenSystemAutoLoginSettingsCommand}"
                                                 Header="{loc:Loc Menu.AutoLogin.System}"
                                                 ToolTip="{loc:Loc Menu.AutoLogin.System.ToolTip}" />
                                </ui:MenuItem>
                                <Separator />
                                <ui:MenuItem Header="{loc:Loc Menu.Diagnostics}">
                                    <ui:MenuItem Command="{Binding OpenDiagnosticsCommand}"
                                                 Header="{loc:Loc Menu.Diagnostics.Open}"
                                                 ToolTip="{loc:Loc Menu.Diagnostics.Open.ToolTip}" />
                                    <Separator />
                                    <ui:MenuItem Command="{Binding CopyDiagnosticsCommand}"
                                                 Header="{loc:Loc Menu.Diagnostics.CopyEnv}"
                                                 Icon="{ui:SymbolIcon Copy24}" />
                                    <ui:MenuItem Command="{Binding OpenLogFolderCommand}"
                                                 Header="{loc:Loc Menu.Diagnostics.Logs}"
                                                 Icon="{ui:SymbolIcon DocumentText24}" />
                                    <ui:MenuItem Command="{Binding OpenSettingsFolderCommand}"
                                                 Header="{loc:Loc Menu.Diagnostics.Settings}"
                                                 Icon="{ui:SymbolIcon Settings24}" />
                                    <Separator />
                                    <ui:MenuItem Command="{Binding DisableChildSessionsCommand}"
                                                 Header="{loc:Loc Menu.Diagnostics.DisableChildSessions}"
                                                 Icon="{ui:SymbolIcon ArrowReset24}" />
                                </ui:MenuItem>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <ui:Button Width="40"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               Command="{Binding ToggleAudioMutedCommand}"
                               CornerRadius="0"
                               ToolTip="{Binding AudioButtonToolTip}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon>
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="{x:Type ui:SymbolIcon}">
                                        <Setter Property="Symbol" Value="Speaker224" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAudioMuted}" Value="True">
                                                <Setter Property="Symbol" Value="SpeakerOff24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Width="40"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               Command="{Binding ToggleTopmostCommand}"
                               CornerRadius="0"
                               Icon="{ui:SymbolIcon PinOff24}"
                               ToolTip="{Binding TopmostButtonToolTip}"
                               Visibility="{Binding IsTopmost, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                    <ui:Button Width="40"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               Command="{Binding ToggleTopmostCommand}"
                               CornerRadius="0"
                               Icon="{ui:SymbolIcon Pin24}"
                               ToolTip="{Binding TopmostButtonToolTip}"
                               Visibility="{Binding IsTopmost, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ===== 通知条 =====
             挂在根容器上而不是标题栏：全屏时标题栏是 Collapsed，
             以它为锚点的 Popup 会失去定位基准，提示就飘到看不见的地方。
             Popup 是独立窗口，所以提示始终画在外层桌面、浮在分身画面之上。 -->
        <Popup x:Name="NotificationPopup"
               Width="{Binding ActualWidth, ElementName=RootGrid}"
               AllowsTransparency="True"
               IsOpen="{Binding IsNotificationOpen, Mode=TwoWay}"
               Placement="Relative"
               PlacementTarget="{Binding ElementName=RootGrid}"
               PopupAnimation="Fade"
               StaysOpen="True"
               VerticalOffset="32">
            <Grid Background="Transparent">
                <Border MaxWidth="720"
                        Margin="8"
                        HorizontalAlignment="Center"
                        Background="#FF2B2B2B"
                        CornerRadius="8">
                    <ui:InfoBar Background="#FF2B2B2B"
                                IsClosable="True"
                                IsOpen="{Binding IsNotificationOpen, Mode=TwoWay}"
                                Message="{Binding NotificationMessage}"
                                Severity="{Binding NotificationSeverity}"
                                Title="{Binding NotificationTitle}" />
                </Border>
            </Grid>
        </Popup>

        <!-- ===== 内容区：RDP 画面与连接引导 ===== -->
        <Grid Grid.Row="1"
              Background="Black">
            <b:Interaction.Behaviors>
                <behaviors:WindowResizeBehavior AspectRatio="1.7777777777777777"
                                               IsSmallWindowMode="{Binding IsSmallWindowMode}"
                                               NormalWindowPosition="{Binding NormalWindowPosition, Mode=TwoWay}"
                                               ResizeRequest="{Binding SmallWindowResizeRequest}"
                                               SmallWindowPosition="{Binding SmallWindowPosition, Mode=TwoWay}"
                                               TargetWidth="{Binding WindowResizeTargetWidth}" />
            </b:Interaction.Behaviors>

            <wfi:WindowsFormsHost x:Name="RdpFormsHost"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Visibility="{Binding IsConnectionPromptVisible, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                <b:Interaction.Behaviors>
                    <behaviors:WindowAspectRatioBehavior AspectRatio="1.7777777777777777"
                                                        IsEnabled="{Binding KeepAspectRatio}" />
                </b:Interaction.Behaviors>
                <wfi:WindowsFormsHost.Style>
                    <Style TargetType="{x:Type wfi:WindowsFormsHost}">
                        <!-- 为父窗口保留命中测试区域，避免 RDP 的子 HWND 截获窗口边缘的鼠标消息 -->
                        <Setter Property="Margin" Value="3,0,3,3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                         Value="Maximized">
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </wfi:WindowsFormsHost.Style>
            </wfi:WindowsFormsHost>

            <Grid Margin="24"
                  Visibility="{Binding IsConnectionPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border MaxWidth="640"
                        Padding="36,30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FF171717"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Width="72"
                                    Height="72"
                                    HorizontalAlignment="Center"
                                    Background="#262FA4E7"
                                    CornerRadius="36"
                                    Visibility="{Binding IsSessionClosing, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                                <ui:SymbolIcon FontSize="34"
                                               Foreground="#FF60B9F4"
                                               Symbol="DesktopCursor24" />
                            </Border>

                            <Border Width="72"
                                    Height="72"
                                    HorizontalAlignment="Center"
                                    Background="#26FFB900"
                                    CornerRadius="36"
                                    Visibility="{Binding IsSessionClosing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:ProgressRing Width="34"
                                                 Height="34"
                                                 Foreground="#FFFFC83D"
                                                 IsIndeterminate="True" />
                            </Border>

                            <StackPanel Margin="0,20,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Ellipse Width="10"
                                         Height="10"
                                         Margin="0,0,9,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding ConnectionStatusBrush}" />
                                <TextBlock FontSize="21"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding ConnectionStatusTitle}" />
                            </StackPanel>

                            <TextBlock MaxWidth="520"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="#BFFFFFFF"
                                       Text="{Binding ConnectionStatusDescription}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />

                            <Border Margin="0,20,0,0"
                                    Padding="16,12"
                                    Background="#10000000"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <StackPanel>
                                    <TextBlock Foreground="#E6FFFFFF" Text="{Binding RdpStatusText}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="#99FFFFFF"
                                               Text="{Binding ChildSessionStatusText}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#70FFFFFF"
                                               FontSize="11"
                                               Text="{Binding ConnectionStatusToolTip}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,22,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsSessionClosing, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                                <ui:Button MinWidth="132"
                                           Command="{Binding StartCommand}"
                                           Content="{loc:Loc Startup.Connect}"
                                           Icon="{ui:SymbolIcon Play24}" />
                                <ui:HyperlinkButton Margin="16,0,0,0"
                                                    Padding="8,6"
                                                    Command="{Binding CopyDiagnosticsCommand}"
                                                    Content="{loc:Loc Startup.CopyDiagnostics}"
                                                    Cursor="Hand" />
                            </StackPanel>

                            <TextBlock Margin="0,22,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="#CCFFFFFF"
                                       Text="{loc:Loc Startup.Closing}"
                                       TextAlignment="Center"
                                       Visibility="{Binding IsSessionClosing, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <StackPanel Margin="0,18,0,0"
                                        Visibility="{Binding IsSessionClosing, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="#80FFFFFF"
                                           FontSize="11"
                                           Text="{loc:Loc Startup.Hint.Switch}"
                                           TextAlignment="Center" />
                                <TextBlock Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="#80FFFFFF"
                                           FontSize="11"
                                           Text="{loc:Loc Startup.Hint.FirstLogin}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="#80FFFFFF"
                                           FontSize="11"
                                           Text="{loc:Loc Startup.Hint.Close}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== 全屏顶栏 =====
                 必须用 Popup 承载：分身画面是 WindowsFormsHost 里的独立 HWND，
                 WPF 元素没法画在它上面（airspace 问题）。Popup 是独立窗口，才能真的浮在画面之上。 -->
            <Popup x:Name="FullscreenBarPopup"
                   AllowsTransparency="True"
                   Placement="Relative"
                   PlacementTarget="{Binding ElementName=RootGrid}"
                   PopupAnimation="Fade"
                   StaysOpen="True">
                <Border Padding="10,6"
                        Background="#E61F1F1F"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="4,0,14,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{loc:Loc Fullscreen.Title}" />
                        <ui:Button Width="36"
                                   Height="30"
                                   Click="OnFullscreenMinimizeClicked"
                                   Content="—"
                                   ToolTip="{loc:Loc Fullscreen.Minimize}" />
                        <ui:Button Width="52"
                                   Height="30"
                                   Margin="6,0,0,0"
                                   Click="OnFullscreenRestoreClicked"
                                   Content="{loc:Loc Fullscreen.Restore}"
                                   ToolTip="{loc:Loc Fullscreen.Restore.ToolTip}" />
                        <ui:Button Width="36"
                                   Height="30"
                                   Margin="6,0,0,0"
                                   Click="OnFullscreenCloseClicked"
                                   Content="✕"
                                   ToolTip="{loc:Loc Common.Close}" />
                        <Border Width="1"
                                Margin="10,4"
                                Background="#33FFFFFF" />
                        <ui:Button x:Name="FullscreenPinOnButton"
                                   Width="36"
                                   Height="30"
                                   Click="OnFullscreenTogglePinClicked"
                                   ToolTip="{loc:Loc Fullscreen.Pin}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon FontSize="14" Symbol="Pin24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="FullscreenPinOffButton"
                                   Width="36"
                                   Height="30"
                                   Click="OnFullscreenTogglePinClicked"
                                   ToolTip="{loc:Loc Fullscreen.Unpin}"
                                   Visibility="Collapsed">
                            <ui:Button.Icon>
                                <ui:SymbolIcon FontSize="14" Symbol="PinOff24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</ui:FluentWindow>
