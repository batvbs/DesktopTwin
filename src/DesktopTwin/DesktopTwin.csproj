<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>DesktopTwin</RootNamespace>
		<AssemblyName>DesktopTwin</AssemblyName>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<LangVersion>14.0</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- 图标取自系统远程桌面客户端，由 build/make-icon.ps1 原样重打包（多尺寸、零缩放） -->
		<ApplicationIcon>Assets\DesktopTwin.ico</ApplicationIcon>
		<!-- WPF 的 DPI 感知由 app.manifest 声明；WinForms 的 WFO0003 分析器不适用于本项目的混合场景 -->
		<NoWarn>$(NoWarn);WFO0003</NoWarn>
		<Version>0.2.3</Version>
		<Product>DesktopTwin 桌面分身</Product>
		<AssemblyTitle>DesktopTwin 桌面分身</AssemblyTitle>
		<Description>把 Windows 自带的第二个桌面会话（RDP Child Session）变成桌面上的一个窗口。</Description>
		<Company>DesktopTwin contributors</Company>
		<Copyright>Copyright (C) 2026 DesktopTwin contributors</Copyright>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
		<PackageReference Include="WPF-UI" Version="4.2.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- 同时作为 WPF 资源嵌入：窗口图标与托盘图标从这里读，避免依赖 exe 的 Win32 图标资源 -->
		<Resource Include="Assets\DesktopTwin.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- 让测试能直接调用 internal 的安全守卫，而不必把它们提升成公共 API -->
		<InternalsVisibleTo Include="DesktopTwin.Tests" />
	</ItemGroup>

	<!-- ===== 分身端代理 =====
	     用 Windows 自带的 .NET Framework csc（任何 Windows 10/11 都自带）把
	     src/SessionAgent 编译成 WinExe：GUI 子系统进程不分配控制台，从根上消除
	     「分身里常驻一个 PowerShell 窗口」；启动也是毫秒级，不会因为冷启动慢
	     被主程序误判成掉线。产物作为嵌入资源打进主程序，发布仍是单文件。

	     所有属性都在 Target 内部求值：IntermediateOutputPath 在项目求值阶段还是空的，
	     写在 Target 外面的 PropertyGroup 里会得到相对路径，产物会落到项目目录里，
	     再被 **/*.cs 通配进来，导致「MainWindow 重复定义」这类莫名其妙的编译错误。 -->
	<Target Name="BuildSessionAgent" BeforeTargets="PrepareForBuild">
		<PropertyGroup>
			<SessionAgentSource>$(MSBuildThisFileDirectory)..\SessionAgent\SessionAgentProgram.cs</SessionAgentSource>
			<SessionAgentManifest>$(MSBuildThisFileDirectory)..\SessionAgent\app.manifest</SessionAgentManifest>
			<SessionAgentIcon>$(MSBuildProjectDirectory)\Assets\DesktopTwin.ico</SessionAgentIcon>
			<SessionAgentOutput>$(IntermediateOutputPath)DesktopTwin.Agent.exe</SessionAgentOutput>
			<SessionAgentCompiler>$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\csc.exe</SessionAgentCompiler>
			<SessionAgentCompiler Condition="!Exists('$(SessionAgentCompiler)')">$(WINDIR)\Microsoft.NET\Framework\v4.0.30319\csc.exe</SessionAgentCompiler>
		</PropertyGroup>

		<Error Condition="!Exists('$(SessionAgentCompiler)')"
		       Text="找不到 .NET Framework 的编译器，无法构建分身端代理。" />
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<Exec Command="&quot;$(SessionAgentCompiler)&quot; /nologo /target:winexe /optimize+ /win32manifest:&quot;$(SessionAgentManifest)&quot; /win32icon:&quot;$(SessionAgentIcon)&quot; /out:&quot;$(SessionAgentOutput)&quot; /reference:System.dll /reference:System.Core.dll /reference:System.Windows.Forms.dll /reference:System.Drawing.dll /reference:System.Management.dll &quot;$(SessionAgentSource)&quot;" />

		<ItemGroup>
			<EmbeddedResource Include="$(SessionAgentOutput)" LogicalName="DesktopTwin.Agent.exe" />
		</ItemGroup>
	</Target>

</Project>
